# DocForge 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== 服务配置 ==========
# 服务端口 (默认 3456)
# PORT=3456

# CORS 允许的前端域名 (逗号分隔，生产部署必填)
# CORS_ORIGINS=http://localhost:5173

# ========== Python 配置 ==========
# Python 可执行文件绝对路径 (可选，默认自动检测 .venv)
# PYTHON_PATH=/path/to/python

# Python 虚拟环境目录名 (可选，默认 .venv)
# PYTHON_VENV_PATH=.venv

# ========== LLM 模型配置 ==========
# 也可通过 Web 界面 /api/model/config 配置
# MODELSCOPE_API_KEY=ms-your-api-key-here
# LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# LLM_MODEL=qwen-plus
